# Copie para .env.local (nunca commitar) — apps/web também lê deste arquivo em dev.

# Supabase — projeto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Só no servidor e nas Edge Functions. Ignora RLS. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Normalização de laudo por LLM (opcional em dev)
ANTHROPIC_API_KEY=sk-ant-...
AGROTECH_LLM_MODELO=claude-sonnet-4-6

# E-mail transacional (convite do produtor)
RESEND_API_KEY=re_...

# Cobrança (Asaas) — só nas Edge Functions
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=          # header asaas-access-token do webhook
AGROTECH_APP_URL=http://localhost:3000

# CAPTCHA (Turnstile) — habilitar no painel do Supabase
TURNSTILE_SECRET=

# CI / deploy (apenas GitHub Secrets, não no .env local)
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=
# VERCEL_TOKEN=
