{
  "name": "agrotech",
  "private": true,
  "version": "0.1.0",
  "description": "AgroTech — módulo de assistência técnica agronômica do ecossistema Campo Forte",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace @agrotech/agro-core",
    "test:core": "npm run test --workspace @agrotech/agro-core",
    "dev": "npm run dev --workspace @agrotech/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
